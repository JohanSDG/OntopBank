<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Contrato Oficial de Préstamo OntopBank - AIDA MEJIA GARCIA</title>
  <style>
    @page {
      size: letter portrait;
      margin: 0;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    body {
      font-family: 'Plus Jakarta Sans', 'Inter', 'Segoe UI', Arial, sans-serif;
      background: #E2E8F0;
      color: #1E293B;
      line-height: 1.36;
      font-size: 10.5px;
    }
    .legal-sheet {
      position: relative;
      width: 8.5in;
      height: 11in;
      background: #FFFFFF;
      margin: 0 auto 24px auto;
      padding: 0.38in 0.55in 0.38in 0.76in;
      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.28);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      page-break-after: always;
      break-after: page;
    }
    .legal-sheet:last-child {
      page-break-after: auto;
      break-after: auto;
      margin-bottom: 0;
    }
    /* Franja lateral izquierda vertical idéntica al modelo Word de Ontop */
    .ontop-left-ribbon {
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      width: 0.28in;
      background: linear-gradient(180deg, #FF9482 0%, #FF5E7E 52%, #FF1E62 100%);
    }
    .sheet-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 8px;
      border-bottom: 1.5px solid #F1F5F9;
      margin-bottom: 8px;
    }
    .doc-main-title {
      font-size: 13.5px;
      font-weight: 900;
      letter-spacing: 0.02em;
      color: #0F172A;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .approval-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #ECFDF5;
      border: 1px solid #6EE7B7;
      border-left: 4px solid #10B981;
      border-radius: 6px;
      padding: 6px 12px;
      margin-bottom: 7px;
    }
    .approval-banner strong {
      color: #065F46;
      font-size: 11px;
    }
    .parties-paragraph {
      font-size: 9.8px;
      color: #334155;
      text-align: justify;
      margin-bottom: 7px;
    }
    .summary-grid-box {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      background: #F8FAFC;
      border: 1px solid #CBD5E1;
      border-radius: 8px;
      padding: 8px 12px;
      margin-bottom: 7px;
    }
    .summary-col h4 {
      font-size: 9.5px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #6D28D9;
      margin-bottom: 4px;
      border-bottom: 1px solid #E2E8F0;
      padding-bottom: 2px;
    }
    .summary-line {
      font-size: 9.4px;
      margin-bottom: 2px;
      color: #1E293B;
    }
    .amortization-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 8.5px;
      margin-bottom: 7px;
    }
    .amortization-table thead th {
      background: #0F172A;
      color: #FFFFFF;
      padding: 4px 8px;
      text-transform: uppercase;
      font-size: 8px;
      letter-spacing: 0.04em;
    }
    .amortization-table tfoot td {
      background: #F1F5F9;
      font-weight: 900;
      padding: 4px 8px;
      border-top: 2px solid #0F172A;
      color: #0F172A;
    }
    .prepayment-callout {
      background: #F5F3FF;
      border: 1px solid #C4B5FD;
      border-left: 4px solid #7C3AED;
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 9.2px;
      color: #2E1065;
      text-align: justify;
    }
    .legal-clause-title {
      font-size: 11px;
      font-weight: 800;
      color: #0F172A;
      margin-top: 8px;
      margin-bottom: 3px;
      text-transform: uppercase;
    }
    .legal-clause-text {
      font-size: 9.9px;
      color: #334155;
      text-align: justify;
      margin-bottom: 6px;
      line-height: 1.44;
    }
    .signatures-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1.5px solid #CBD5E1;
    }
    .sig-box {
      font-size: 10px;
      color: #1E293B;
    }
    .sig-line {
      height: 44px;
      border-bottom: 1.5px solid #0F172A;
      margin-bottom: 6px;
      display: flex;
      align-items: flex-end;
      padding-bottom: 4px;
      font-family: 'Georgia', serif;
      font-style: italic;
      font-size: 15px;
      color: #4C1D95;
    }
    .sheet-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 8.8px;
      color: #64748B;
      border-top: 1px solid #E2E8F0;
      padding-top: 5px;
    }
    @media print {
      body {
        background: #FFFFFF;
      }
      .legal-sheet {
        margin: 0;
        box-shadow: none;
      }
    }
  </style>
</head>
